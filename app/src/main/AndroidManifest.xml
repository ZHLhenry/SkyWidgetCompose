<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 二维码扫描示例需要相机权限，由消费者（app 模块）声明并申请 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 识别成功后的震动反馈需要振动权限（Android 13+ 使用 VibratorManager 需要） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="com.sky.widget.samplecp.SampleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${app_icon}"
        android:label="@string/app_name"
        android:roundIcon="${app_icon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkyWidgetCompose">
        <activity
            android:name="com.sky.widget.samplecp.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SkyWidgetCompose"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>